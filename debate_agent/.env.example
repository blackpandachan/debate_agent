# Copy to debate_agent/.env (ADK loads .env from the agent directory).

# Google AI Studio (GEMINI_API_KEY also works)
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=your-api-key

# Or Vertex AI:
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional tuning
# DEBATE_MODEL=gemini-3.5-flash
# JUDGE_MODEL=gemini-3.5-flash
# MAX_DEBATE_ROUNDS=3
# ENABLE_SEARCH=true
# ENABLE_FACT_CHECK=true
# LLM_RETRY_ATTEMPTS=5

# Claude as the judge (moderator + final judge). Debaters and the
# fact-checker stay on Gemini because they need Google Search.
# JUDGE_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=...
# FACT_CHECK_MODEL=gemini-3.5-flash

# Other providers go through LiteLLM (pip install litellm):
# DEBATE_MODEL=openai/gpt-5
# OPENAI_API_KEY=...
